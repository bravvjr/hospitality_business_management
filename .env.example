# Copy to .env for local (non-Docker) development.
ENVIRONMENT=local
DEBUG=false

# App runtime connects as a NON-owner role so PostgreSQL RLS is enforced (ADR-002).
DATABASE_URL=postgresql+asyncpg://hbm_app:hbm_app@localhost:5432/hbm
# Migrations run as the OWNER role.
MIGRATION_DATABASE_URL=postgresql+asyncpg://hbm:hbm@localhost:5432/hbm
DB_ECHO=false

# Owner role / database (used by docker-compose for the Postgres service).
POSTGRES_USER=hbm
POSTGRES_PASSWORD=hbm
POSTGRES_DB=hbm
# Non-owner runtime role created by docker/initdb on first boot.
APP_DB_ROLE=hbm_app
APP_DB_PASSWORD=hbm_app

# Auth (ADR-003). Required outside local dev.
JWT_SECRET_KEY=dev-only-change-me

# Rate limiting for sensitive auth endpoints (per client IP, per endpoint).
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
