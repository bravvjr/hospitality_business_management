# Copy to .env for local (non-Docker) development.
ENVIRONMENT=local
DEBUG=false

# Async SQLAlchemy URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://hbm:hbm@localhost:5432/hbm
DB_ECHO=false

# Values used by docker-compose for the Postgres service.
POSTGRES_USER=hbm
POSTGRES_PASSWORD=hbm
POSTGRES_DB=hbm

# Auth (ADR-003). Required outside local dev.
JWT_SECRET_KEY=dev-only-change-me
